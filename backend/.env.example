# Copy to .env (never commit .env). All secrets live in Render/Vercel dashboards in prod.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/resumeiq
# Supabase — get from Supabase dashboard > Project Settings > Database
# Example: postgresql+psycopg2://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Supabase — Project Settings > API (URL + anon/service_role keys) and Database (URI)
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=change-me
SUPABASE_SERVICE_KEY=change-me
SUPABASE_STORAGE_BUCKET=resumes-private
# Auth: roles (candidate|recruiter|admin) live in user_metadata.role.
# Set true only for local dev without a real Supabase project. Never true in prod.
SUPABASE_BYPASS_AUTH=false

# Gemini
GEMINI_API_KEY=change-me
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004
# free | paid — free tier trains on prompts/responses, NEVER send real resumes on free.
GEMINI_TIER=free

# Upstash Redis (optional cache, Phase 2+)
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

BACKEND_CORS_ORIGINS=http://localhost:3000
ENV=development
